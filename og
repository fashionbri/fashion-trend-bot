import os, time, hashlib, mimetypes, json, re
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlencode
import requests
from tqdm import tqdm
from PIL import Image
import numpy as np
import cv2
import pandas as pd

# ---- Settings (edit queries freely) ----
QUERIES = [
  "vogue runway emerald dress",
  "leopard print runway 1990s",
  "Gucci Fall 2013 runway",
  "Chanel haute couture 2020",
  "Balmain burgundy runway 2025"
]
IMAGES_PER_QUERY = 60   # keep moderate to control runtime
OUT_DIR = Path("data/latest")
OUT_DIR.mkdir(parents=True, exist_ok=True)

BING_KEY = os.environ.get("BING_API_KEY")
SERP_KEY = os.environ.get("SERP_API_KEY")
assert BING_KEY and SERP_KEY, "Set BING_API_KEY and SERP_API_KEY in secrets."

# ---- Helpers ----
def extension_from_mime(m):
    if not m: return ".jpg"
    if "png" in m: return ".png"
    if "webp" in m: return ".webp"
    if "jpeg" in m: return ".jpg"
    return ".jpg"

def save_img(url, prefix, save_dir):
    try:
        r = requests.get(url, stream=True, timeout=20, headers={"User-Agent":"Mozilla/5.0"})
        r.raise_for_status()
        ctype = r.headers.get("Content-Type","")
        if "image" not in ctype and not url.lower().endswith((".jpg",".jpeg",".png",".webp")):
            return None
        data = r.content
        if len(data) < 20_000:  # skip tiny assets
            return None
        h = hashlib.sha256(data).hexdigest()[:16]
        ext = extension_from_mime(ctype)
        fpath = save_dir / f"{prefix}_{h}{ext}"
        with open(fpath, "wb") as f: f.write(data)
        return fpath
    except Exception:
        return None

def search_bing(q, count):
    headers = {"Ocp-Apim-Subscription-Key": BING_KEY}
    params = {"q": q, "count": count, "safeSearch": "Moderate", "imageType": "Photo"}
    try:
        res = requests.get("https://api.bing.microsoft.com/v7.0/images/search",
                           headers=headers, params=params, timeout=20)
        res.raise_for_status()
        data = res.json()
        return [x.get("contentUrl") for x in data.get("value", []) if x.get("contentUrl")]
    except Exception:
        return []

def search_google_serpapi(q, count):
    try:
        res = requests.get("https://serpapi.com/search.json",
            params={"engine":"google_images","q":q,"ijn":0,"api_key":SERP_KEY}, timeout=20)
        res.raise_for_status()
        data = res.json()
        return [x.get("original") for x in data.get("images_results", []) if x.get("original")][:count]
    except Exception:
        return []

# ---- Download step ----
IM_DIR = OUT_DIR / "images"
IM_DIR.mkdir(parents=True, exist_ok=True)
download_manifest = []

for q in QUERIES:
    urls = set(search_bing(q, IMAGES_PER_QUERY) + search_google_serpapi(q, IMAGES_PER_QUERY))
    saved_paths = []
    for u in tqdm(list(urls)[:IMAGES_PER_QUERY*2], desc=f"Downloading {q[:30]}"):
        p = save_img(u, prefix=re.sub(r"[^a-zA-Z0-9._-]+","_",q)[:40], save_dir=IM_DIR)
        if p:
            saved_paths.append(p)
            download_manifest.append({"query": q, "path": str(p), "url": u})
    time.sleep(1)

pd.DataFrame(download_manifest).to_csv(OUT_DIR/"download_manifest.csv", index=False)

# ---- Color extraction (OpenCV KMeans top-5) ----
def dominant_colors(path, k=5):
    img = Image.open(path).convert("RGB")
    arr = np.array(img)
    Z = arr.reshape((-1,3)).astype(np.float32)
    criteria = (cv2.TERM_CRITERIA_EPS+cv2.TERM_CRITERIA_MAX_ITER, 20, 1.0)
    _ , labels, centers = cv2.kmeans(Z, k, None, criteria, 8, cv2.KMEANS_PP_CENTERS)
    centers = np.uint8(centers)
    counts = np.bincount(labels.flatten(), minlength=k)
    fracs = counts / counts.sum()
    return sorted([(f"#{r:02x}{g:02x}{b:02x}", float(fr)) for (r,g,b),fr in zip(centers,fracs)],
                  key=lambda x: x[1], reverse=True)

rows=[]
for p in tqdm(list(IM_DIR.glob("*")), desc="Extracting colors"):
    if p.is_file() and p.suffix.lower() in [".jpg",".jpeg",".png",".webp"]:
        for rank,(hexcol,share) in enumerate(dominant_colors(p, k=5), start=1):
            rows.append({"image_path": str(p), "rank": rank, "color_hex": hexcol, "share": share})
colors_df = pd.DataFrame(rows)
colors_df.to_csv(OUT_DIR/"colors_opencv.csv", index=False)

# ---- Minimal daily summary (top colors across all queries today) ----
summary = (colors_df.query("rank==1")
           .groupby("color_hex")["image_path"].count()
           .reset_index(name="count")
           .sort_values("count", ascending=False))
summary.to_csv(OUT_DIR/"top_colors_today.csv", index=False)

# ---- Stamp a dated snapshot for history ----
stamp = datetime.now(timezone.utc).strftime("%Y-%m-%d_%H%M_UTC")
hist = Path(f"data/history/{stamp}")
hist.mkdir(parents=True, exist_ok=True)
for f in ["download_manifest.csv","colors_opencv.csv","top_colors_today.csv"]:
    (OUT_DIR/f).replace(hist/f)  # move files into history folder
# also keep "latest" copies
hist.mkdir(parents=True, exist_ok=True)
for src in hist.glob("*"):
    dst = OUT_DIR/src.name
    dst.write_bytes(src.read_bytes())
print("Done.")


name: fashion-trend-bot
on:
  schedule:
    - cron: '0 6 * * *'   # 06:00 UTC (morning)
    - cron: '0 18 * * *'  # 18:00 UTC (night)
  workflow_dispatch: {}

jobs:
  run-bot:
    runs-on: ubuntu-latest
    permissions:
      contents: write   # allow committing results back to the repo
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install deps
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run updater
        env:
          BING_API_KEY: ${{ secrets.BING_API_KEY }}
          SERP_API_KEY: ${{ secrets.SERP_API_KEY }}
        run: python search_and_update.py

      - name: Commit & push results
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add data/
          git commit -m "Auto update: $(date -u +'%Y-%m-%d %H:%M UTC')" || echo "No changes"
          git push
